PORT=8080
NODE_ENV=development

# Ollama LLM (primary extraction engine)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://10.21.231.80:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_MS=60000

# Optional: local GLiNER NLP fallback (leave defaults if not using)
NLP_PYTHON_CMD=python
NLP_SERVICE_SCRIPT=python/gliner_service.py

# Drop PDF, DOCX, DOC, PPTX, TXT, or EML files into UPLOAD_INBOX_DIR,
# then POST /api/local/process-inbox to batch-parse them.
UPLOAD_INBOX_DIR=uploads/inbox
UPLOAD_OUTPUT_DIR=uploads/parsed
UPLOAD_PROCESSED_DIR=uploads/processed
