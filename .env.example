PORT=8080

NODE_ENV=development



GMAIL_CLIENT_ID=your_google_client_id

GMAIL_CLIENT_SECRET=your_google_client_secret

GMAIL_REDIRECT_URI=http://localhost:8080/api/gmail/oauth2/callback

GMAIL_REFRESH_TOKEN=your_refresh_token

GMAIL_USER_ID=me



NLP_PYTHON_CMD=python

NLP_SERVICE_SCRIPT=python/gliner_service.py



OLLAMA_ENABLED=true

OLLAMA_BASE_URL=http://localhost:11434

OLLAMA_MODEL=qwen2.5:7b-instruct

OLLAMA_TIMEOUT_MS=25000



# Drop PDF, DOCX, DOC, PPTX, TXT, or EML files into UPLOAD_INBOX_DIR, then POST /api/local/process-inbox

UPLOAD_INBOX_DIR=uploads/inbox

UPLOAD_OUTPUT_DIR=uploads/parsed

UPLOAD_PROCESSED_DIR=uploads/processed

